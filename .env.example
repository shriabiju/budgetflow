# Copy this file to .env and fill in your actual PostgreSQL credentials.
# Never commit the real .env file.

# Option A: individual connection details (used for local development)
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=budgetflow

# Option B: a single connection string (used in production — Render/Neon/etc.)
# If DATABASE_URL is set, it takes priority over the DB_* vars above.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require